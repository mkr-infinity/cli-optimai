# Normalized line endings for everyone (matches .editorconfig)
* text=auto

# Always LF in git, native in checkout
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
Dockerfile text eol=lf

# Windows-only assets
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.zip binary
*.tgz binary
*.tar.gz binary

# Mark docs for nicer GitHub diffs
*.md linguist-documentation=false
