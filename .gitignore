# ============================================================
# optimai-telegram-node - git ignore rules
# ============================================================

# Secrets: NEVER commit the real .env (it holds your bot token)
.env

# Runtime state & local machine folders: never commit user/local directories
data/
*.log
.optimai/
optimai/
.local/
.config/
node/
tmp/

# Python bytecode and virtual environments
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS junk
.DS_Store
Thumbs.db
